# Supabase (pre-populated in hosted environment)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Apify
APIFY_API_TOKEN=
APIFY_ACTOR_ID=
APIFY_WEBHOOK_SECRET=

# Provider selection: apify, or mock for local development only
BUSINESS_SEARCH_PROVIDER=apify

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development

# Contact (optional, shown as a direct email link on /contact)
NEXT_PUBLIC_SUPPORT_EMAIL=
CONTACT_RATE_LIMIT_SECRET=
# Resend email delivery for Contact Us (required when APP_ENV=production)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=LeadScout <support@your-verified-domain.com>
CONTACT_TO_EMAIL=

# PayU hosted checkout — keep both values Secret in Vercel.
# Use PAYU_ENVIRONMENT=test while validating with PayU test credentials, then production.
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_ENVIRONMENT=test
# Amounts are Indian Rupees. Configure the live selling prices in Vercel.
PAYU_STARTER_AMOUNT_INR=
PAYU_PRO_AMOUNT_INR=

# Future: Stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Future: Razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Future: Bright Data
# BRIGHT_DATA_TOKEN=
